# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Twilio WhatsApp Sandbox ───────────────────────────────────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+xxxxx   # Twilio sandbox number (don't change this)

# ── Bot behaviour ────────────────────────────────────────────────────────────
# Comma-separated trigger keywords for group chats (case-insensitive)
# e.g. "@xxxxxx"
BOT_TRIGGERS=@footybot

# ── Tournament ────────────────────────────────────────────────────────────────
TOURNAMENT_URL=""
