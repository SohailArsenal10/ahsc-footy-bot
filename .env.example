# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Twilio WhatsApp Sandbox ───────────────────────────────────────────────────
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # Twilio sandbox number (don't change this)

# ── Bot behaviour ────────────────────────────────────────────────────────────
# Comma-separated trigger keywords for group chats (case-insensitive)
# e.g. "@footybot,@footy,@bot"
BOT_TRIGGERS=@footybot

# ── Tournament ────────────────────────────────────────────────────────────────
TOURNAMENT_URL=https://challenge.place/c/68e25e0e0cd837a479b79cc6
